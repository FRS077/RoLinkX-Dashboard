<?php
/*
 * WPS (Push Button) - connexion Wi-Fi automatique via wpa_cli
 * À placer dans le dossier ajax/ du dashboard (ajax/wps.php)
 *
 * Actions (POST) :
 *   action=start   : lance wps_pbc (puis appuyer sur le bouton WPS de la box, ~2 min)
 *   action=status  : renvoie l'état (pending | success | timeout | idle)
 *   action=cancel  : annule la procédure WPS
 */
header('Content-Type: application/json; charset=utf-8');

const WPS_IF      = 'wlan0';
const WPS_STATE   = '/tmp/rolinkx_wps.json';
const WPS_TIMEOUT = 125; // secondes (la fenêtre WPS dure 120 s)

function wcli($args)
{
    return trim((string) shell_exec('/usr/bin/sudo wpa_cli -i ' . WPS_IF . ' ' . $args . ' 2>&1'));
}

function countNetworks()
{
    $n = 0;
    foreach (explode("\n", wcli('list_networks')) as $line) {
        if (preg_match('/^\d+\t/', $line)) {
            $n++;
        }
    }
    return $n;
}

function wpaStatus()
{
    $st = array();
    foreach (explode("\n", wcli('status')) as $line) {
        if (strpos($line, '=') !== false) {
            list($k, $v) = explode('=', $line, 2);
            $st[trim($k)] = trim($v);
        }
    }
    return $st;
}

function reply($arr)
{
    echo json_encode($arr);
    exit;
}

$action = isset($_POST['action']) ? $_POST['action'] : '';

if ($action === 'start') {
    wcli('wps_cancel');
    $out = wcli('wps_pbc');
    if (!preg_match('/\bOK\b/', $out) || stripos($out, 'FAIL') !== false) {
        reply(array('state' => 'error', 'msg' => 'wpa_cli : ' . ($out ?: 'aucune réponse') .
            ' (wpa_supplicant sans WPS, interface absente, ou droits sudo manquants)'));
    }
    $st = wpaStatus();
    file_put_contents(WPS_STATE, json_encode(array(
        't'    => time(),
        'n'    => countNetworks(),
        'ssid' => isset($st['ssid']) ? $st['ssid'] : '',
    )));
    reply(array('state' => 'pending', 'remaining' => WPS_TIMEOUT));
}

if ($action === 'cancel') {
    wcli('wps_cancel');
    @unlink(WPS_STATE);
    reply(array('state' => 'idle', 'msg' => 'WPS annulé'));
}

if ($action === 'status') {
    $init = is_file(WPS_STATE) ? json_decode(file_get_contents(WPS_STATE), true) : null;
    if (!is_array($init)) {
        reply(array('state' => 'idle'));
    }
    $elapsed = time() - (int) $init['t'];
    $st      = wpaStatus();
    $count   = countNetworks();
    $done    = (isset($st['wpa_state']) && $st['wpa_state'] === 'COMPLETED');
    $newNet  = ($count > (int) $init['n']);
    $newSsid = (!empty($st['ssid']) && $st['ssid'] !== $init['ssid']);

    if ($done && ($newNet || $newSsid)) {
        wcli('save_config');
        @unlink(WPS_STATE);
        reply(array('state' => 'success', 'msg' => 'Connecté à ' . $st['ssid'] . ' (réseau enregistré)'));
    }
    if ($elapsed > WPS_TIMEOUT) {
        wcli('wps_cancel');
        @unlink(WPS_STATE);
        reply(array('state' => 'timeout', 'msg' => 'Délai dépassé : aucune box WPS détectée'));
    }
    reply(array('state' => 'pending', 'remaining' => max(0, WPS_TIMEOUT - $elapsed)));
}

reply(array('state' => 'error', 'msg' => 'Action inconnue'));
